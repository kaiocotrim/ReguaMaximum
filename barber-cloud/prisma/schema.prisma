generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  BARBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
}

enum BookingStatus {
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum BookingAttendance {
  PENDENTE
  COMPARECEU
  FALTOU
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  OUTRO
}

enum CashMovementType {
  ENTRADA
  SAIDA
}

enum SubscriptionPlan {
  BASIC
  PRO
  PREMIUM
}

enum PlanLicenseStatus {
  AVAILABLE
  CLAIMED
  ACTIVE
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  telefone      String?

  role UserRole?

  ownedBarbershops Barbershop[] @relation("BarbershopOwner")

  resetPasswordToken  String?
  resetPasswordExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  barber            Barber?
  client            Client?
  bookings          Booking[]
  reviews           Review[]
  barbershopReviews BarbershopReview[]
  favorites         FavoriteBarbershop[]

  // Convites enviados (como dono de barbearia) e recebidos (como barbeiro convidado)
  invitesSent     BarbershopInvite[] @relation("InviteSender")
  invitesReceived BarbershopInvite[] @relation("InviteReceiver")

  isLicenseAdmin Boolean @default(false)

  licensesCreated PlanLicense[] @relation("PlanLicenseCreator")
  licensesClaimed PlanLicense[] @relation("PlanLicenseClaimer")

  @@map("users")
}

model Client {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nome   String?
  avatar String?
  cidade String?

  createdAt DateTime @default(now())
}

model Barber {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nome           String?
  avatar         String?
  bio            String?
  cidade         String?
  especialidades String[]

  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  createdAt       DateTime               @default(now())
  bookings        Booking[]
  reviews         Review[]
  portfolioPhotos BarberPortfolioPhoto[]
}

model Barbershop {
  id                String   @id @default(uuid())
  name              String
  address           String
  phones            String[]
  description       String
  imageUrl          String
  acceptsBookings   Boolean  @default(true)
  cidade            String?
  capaUrl           String?
  tags              String[]
  instagram         String?
  horarioAbertura   String?
  horarioFechamento String?
  corMarca          String?

  ownerId String
  owner   User   @relation("BarbershopOwner", fields: [ownerId], references: [id])

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barbers       Barber[]
  services      BarbeshopService[]
  bookings      Booking[]
  favoritedBy   FavoriteBarbershop[]
  invites       BarbershopInvite[]
  reviews       BarbershopReview[]
  photos        BarbershopPhoto[]
  cashMovements CashMovement[]
  licenses      PlanLicense[]
}

model BarbeshopService {
  id          String  @id @default(uuid())
  name        String
  description String
  imageUrl    String
  price       Decimal @db.Decimal(10, 2)
  duration    Int

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  bookings Booking[]
}

model Booking {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  serviceId String
  service   BarbeshopService @relation(fields: [serviceId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  date DateTime

  status      BookingStatus     @default(EM_ANDAMENTO)
  cancelledAt DateTime?
  attendance  BookingAttendance @default(PENDENTE)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review           Review?
  barbershopReview BarbershopReview?
  payment          Payment?
}

model Payment {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod

  receivedById String
  paidAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([paidAt])
}

model CashMovement {
  id String @id @default(uuid())

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  type        CashMovementType
  amount      Decimal          @db.Decimal(10, 2)
  description String
  method      PaymentMethod?
  occurredAt  DateTime         @default(now())
  createdById String
  createdAt   DateTime         @default(now())

  @@index([barbershopId, occurredAt])
}

model Review {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BarbershopReview {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BarbershopPhoto {
  id String @id @default(uuid())

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  imageUrl String
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([barbershopId, position])
}

model BarberPortfolioPhoto {
  id String @id @default(uuid())

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  imageUrl String
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([barberId, position])
}

model FavoriteBarbershop {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, barbershopId])
}

/// Convite de um dono de barbearia para um barbeiro se juntar à equipe.
/// O vínculo real só é criado (em Barber.barbershopId) quando o convite é aceito
/// pelo service layer — esta tabela representa apenas o estado do processo.
model BarbershopInvite {
  id String @id @default(uuid())

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation("InviteSender", fields: [inviterId], references: [id], onDelete: Cascade)

  inviteeId String
  invitee   User   @relation("InviteReceiver", fields: [inviteeId], references: [id], onDelete: Cascade)

  status      InviteStatus @default(PENDING)
  message     String?
  expiresAt   DateTime
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barbershop_invites")
}

model PlanLicense {
  id           String            @id @default(uuid())
  codeHash     String            @unique
  codePreview  String
  plan         SubscriptionPlan
  durationDays Int
  status       PlanLicenseStatus @default(AVAILABLE)

  customerName  String?
  customerPhone String?
  notes         String?

  createdById String?
  createdBy   User?   @relation("PlanLicenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  claimedById String?
  claimedBy   User?   @relation("PlanLicenseClaimer", fields: [claimedById], references: [id], onDelete: SetNull)

  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: SetNull)

  claimedAt   DateTime?
  activatedAt DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([claimedById, status])
  @@index([barbershopId, status, expiresAt])
  @@map("plan_licenses")
}

model Account {
  id                String @id @default(cuid())
  userId            String @map("user_id")
  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
